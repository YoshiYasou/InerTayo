# InerTayo — Environment Variables
# Copy this file to .env and fill in real values before running the server.

# REQUIRED — secret used to sign JWTs. Must be a long random string (≥32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Recommended for Render: Resend HTTPS API (SMTP ports are restricted on Render free services).
# Verify a sending domain in Resend and use a sender address on that domain.
RESEND_API_KEY=
RESEND_FROM="InerTayo <verification@your-verified-domain.com>"

# Local SMTP fallback — Gmail requires an App Password, not your regular password.
# The Gmail account must have 2-Step Verification enabled.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative standard SMTP provider configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="InerTayo <noreply@inertayo.ph>"

# Optional — Environment mode ('development', 'production', or 'test')
# NODE_ENV=development

# Optional — restrict CORS to your frontend origin(s) (supports comma-separated list)
# Defaults in development: http://localhost:3000,http://localhost:5173
# The local server origin (PORT, default 5000) is always allowed.
# ORIGIN=https://inertayo.yourdomain.ph

# REQUIRED — MongoDB Connection URI (local instance or MongoDB Atlas cluster)
# Local: mongodb://127.0.0.1:27017/inertayo
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/inertayo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/inertayo
# Optional — comma-separated DNS servers for Atlas SRV lookups when system DNS refuses them
# MONGODB_DNS_SERVERS=8.8.8.8

# Optional — HTTP port (default: 5000)
# PORT=5000

# Optional — OpenRouteService / HeiGIT API key for server-side walking and road routing
# Sign up at https://heigit.org/ or the ORS portal to get a free API key.
# If not provided, a deterministic road-network fallback will be used and labeled approximate.
ORS_API_KEY=
# Optional — ORS endpoint/profile tuning (never expose the API key to the frontend)
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ORS_PROFILE=driving-car
# ORS_TIMEOUT_MS=8000

# Optional — Use cleaned Dagupan road coordinates for routing geometry (default: true)
# USE_CORRECTED_GEOMETRY=true
